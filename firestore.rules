rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfis públicos de jogadores e ranking Elo
    match /chess_players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Lista de amigos do jogador
      match /friends/{friendUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Fila de matchmaking rápido
    match /chess_queue/{entryId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Partidas online, chat ao vivo e modo TV espectador
    match /chess_games/{gameId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.white.uid == request.auth.uid ||
        resource.data.black.uid == request.auth.uid
      );

      match /chat/{msgId} {
        allow read, create: if request.auth != null;
      }
    }

    // Desafios diretos entre amigos / jogadores online
    match /chess_challenges/{challengeId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }
  }
}
